generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL_NON_POOLING")
}

model Episode {
  id            String    @id @default(uuid())
  title         String
  description   String?
  publishDate   DateTime?
  fileName      String
  episodeNumber Int
  keywords      Keyword[]
  quotes        Quote[]
  segments      Segment[]
  turns         Turn[]
}

model Speaker {
  id          String    @id
  name        String?
  displayName String?
  quotes      Quote[]
  segments    Segment[]
  turns       Turn[]
}

model Turn {
  id        String    @id @default(uuid())
  startTime String
  endTime   String
  content   String
  episodeId String
  speakerId String
  quotes    Quote[]
  segments  Segment[]
  episode   Episode   @relation(fields: [episodeId], references: [id])
  speaker   Speaker   @relation(fields: [speakerId], references: [id])

  @@index([episodeId])
  @@index([speakerId])
}

model Quote {
  id         String   @id @default(uuid())
  content    String
  episodeId  String
  speakerId  String
  turnId     String?
  segmentId  String? // Add new field as optional
  matchScore Float?
  episode    Episode  @relation(fields: [episodeId], references: [id])
  speaker    Speaker  @relation(fields: [speakerId], references: [id])
  turn       Turn?    @relation(fields: [turnId], references: [id])
  segment    Segment? @relation(fields: [segmentId], references: [id]) // Add new relation as optional

  @@index([episodeId])
  @@index([speakerId])
  @@index([turnId])
  @@index([segmentId])
}

model Segment {
  id        String  @id @default(uuid())
  startTime String
  endTime   String?
  content   String
  episodeId String
  speakerId String
  turnId    String?
  quotes    Quote[] // Change to array but keep existing fields
  episode   Episode @relation(fields: [episodeId], references: [id])
  speaker   Speaker @relation(fields: [speakerId], references: [id])
  turn      Turn?   @relation(fields: [turnId], references: [id])

  @@index([episodeId])
  @@index([speakerId])
  @@index([turnId])
}

model Keyword {
  id        String  @id @default(uuid())
  word      String
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id])

  @@index([word])
  @@index([episodeId])
}
